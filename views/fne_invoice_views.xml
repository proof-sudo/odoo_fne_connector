<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- 1. Héritage Form View account.move -->
        <!-- ============================================================ -->
        <record id="view_move_form_inherit_fne_main" model="ir.ui.view">
            <field name="name">account.move.form.inherit.fne.main</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Injection propre dans le header -->
                <xpath expr="//header" position="inside">

                    <!-- Champs nécessaires aux conditions -->
                    <field name="fne_sent" invisible="1"/>
                    <field name="fne_warning" invisible="1"/>

                    <!-- Bouton Créer FNE -->
                    <button name="action_send_to_fne"
                            string="Créer FNE"
                            type="object"
                            class="btn-primary"
                            invisible="fne_sent or state in ('draft', 'cancel')"/>

                    <!-- Bouton Voir FNE -->
                    <button name="action_open_fne_link"
                            string="Voir FNE"
                            type="object"
                            class="oe_highlight"
                            invisible="not fne_sent"/>

                    <!-- Alerte -->
                    <div class="alert alert-warning"
                         invisible="not fne_warning">
                        La DGI a renvoyé un avertissement pour cette facture.
                    </div>

                </xpath>

                <!-- Ajout champ mode paiement -->
                <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                    <field name="modes_paiement"/>
                </xpath>

                <!-- Bloc Informations FNE -->
                <xpath expr="//notebook" position="before">
                    <div class="oe_read_only" invisible="not fne_sent">
                        <group string="Informations de Certification FNE / DGI">
                            <field name="fne_reference_dgi"/>
                            <field name="fne_balance_sticker" string="Solde Sticker FNE"/>
                            <field name="fne_warning"
                                   string="Avertissement DGI"
                                   readonly="1"
                                   invisible="not fne_warning"/>
                        </group>
                    </div>
                </xpath>

            </field>
        </record>

        <!-- ============================================================ -->
        <!-- 2. Héritage Tree View account.move -->
        <!-- ============================================================ -->
        <record id="view_invoice_tree_inherit_fne" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.fne</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">

                <!-- Décoration si envoyé -->
                <xpath expr="//tree" position="attributes">
                    <attribute name="decoration-success">fne_sent</attribute>
                </xpath>

                <!-- Ajout boutons -->
                <xpath expr="//tree" position="inside">

                    <field name="fne_sent" column_invisible="1"/>

                    <button name="action_send_to_fne"
                            string="Créer FNE"
                            type="object"
                            icon="fa-upload"
                            invisible="fne_sent"/>

                    <button name="action_open_fne_link"
                            string="Voir FNE"
                            type="object"
                            icon="fa-eye"
                            invisible="not fne_sent"/>

                </xpath>

            </field>
        </record>

    </data>
</odoo>