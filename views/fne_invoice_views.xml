<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ************************************************************ -->
        <!-- 1. Héritage de la Vue Formulaire (Boutons et Champs Infos)    -->
        <!-- ************************************************************ -->
        <record id="view_move_form_inherit_fne_main" model="ir.ui.view">
            <field name="name">account.move.form.inherit.fne.main</field>
            <!-- ✅ ODOO 16 : account.invoice → account.move -->
            <field name="model">account.move</field>
            <!-- ✅ ODOO 16 : account.invoice_form → account.view_move_form -->
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Champs de statut invisibles mais nécessaires pour les conditions -->
                <header position="inside">

                    <button name="action_send_to_fne"
                        string="Créer FNE"
                        type="object"
                        class="btn-primary"
                        invisible="fne_sent or state in ('draft', 'cancel')"
                    />

                    <button name="action_open_fne_link"
                        string="Voir FNE"
                        type="object"
                        class="oe_highlight"
                        invisible="not fne_sent"
                    />

                    <label string="Attention: La DGI a renvoyé un avertissement pour cette facture."
                        class="o_form_label"
                        invisible="not fne_warning"
                        style="color: orange; font-weight: bold; margin-left: 10px;"/>

                </header>

                <!-- ✅ ODOO 16 : payment_term_id existe toujours sur account.move -->
                <xpath expr="//field[@name='invoice_payment_term_id']" position="after">
                    <field name="modes_paiement"/>
                </xpath>

                <!-- Informations de certification DGI -->
                <notebook position="before">
                    <div class="oe_read_only" invisible="not fne_sent">
                        <group name="fne_dgi_info" string="Informations de Certification FNE / DGI">
                            <field name="fne_reference_dgi"/>
                            <field name="fne_balance_sticker" string="Solde Sticker FNE"/>
                            <field name="fne_warning" readonly="1" string="Avertissement DGI" invisible="not fne_warning"/>
                        </group>
                    </div>
                </notebook>

            </field>
        </record>

        <!-- ************************************************************ -->
        <!-- 2. Héritage de la Vue Liste (Tree View)                       -->
        <!-- ************************************************************ -->
        <record id="view_invoice_tree_inherit_fne" model="ir.ui.view">
            <field name="name">account.move.tree.inherit.fne</field>
            <!-- ✅ ODOO 16 : account.invoice → account.move -->
            <field name="model">account.move</field>
            <!-- ✅ ODOO 16 : account.invoice_tree → account.view_move_tree -->
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//tree" position="attributes">
                    <attribute name="decoration-success">fne_sent == True</attribute>
                </xpath>

                <xpath expr="//tree" position="inside">
                    <field name="fne_sent" column_invisible="1"/>

                    <!-- ✅ ODOO 16 : attrs → invisible -->
                    <button name="action_send_to_fne"
                            string="Créer FNE"
                            type="object"
                            icon="fa-upload"
                            invisible="fne_sent"
                    />

                    <button name="action_open_fne_link"
                            type="object"
                            string="Voir FNE"
                            icon="fa-eye"
                            invisible="not fne_sent"
                    />
                </xpath>

            </field>
        </record>

    </data>
</odoo>